<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             x:Class="MarkMello.Presentation.Views.InterfaceFontSizeSettingsView"
             x:DataType="vm:ShellViewModel">
  <StackPanel Spacing="0">
    <Line Classes="mm-setting-divider" StartPoint="0,0.5" EndPoint="1,0.5" />
    <Border Classes="mm-setting-row">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <StackPanel Spacing="2" VerticalAlignment="Center">
          <TextBlock Classes="mm-setting-label" TextWrapping="Wrap" Text="{Binding InterfaceFontSizeLabel}" />
          <TextBlock Classes="mm-setting-hint" TextWrapping="Wrap" Text="{Binding InterfaceFontSizeHint}" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Slider Classes="mm-settings-slider"
                  Minimum="{x:Static vm:ShellViewModel.InterfaceFontSizeMinimum}"
                  Maximum="{x:Static vm:ShellViewModel.InterfaceFontSizeMaximum}"
                  TickFrequency="1" IsSnapToTickEnabled="True"
                  Value="{Binding InterfaceFontSizeSetting, Mode=TwoWay}" />
          <TextBlock Classes="mm-slider-value" Text="{Binding InterfaceFontSizeValueLabel}" />
        </StackPanel>
      </Grid>
    </Border>
  </StackPanel>
</UserControl>
