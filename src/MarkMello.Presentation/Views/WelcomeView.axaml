<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MarkMello.Presentation.ViewModels"
             xmlns:controls="using:MarkMello.Presentation.Controls"
             mc:Ignorable="d"
             x:Class="MarkMello.Presentation.Views.WelcomeView"
             x:DataType="vm:ShellViewModel">

  <controls:WelcomePanel HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="6"
                MaxWidth="380">

      <!-- App mark -->
      <Image Source="avares://MarkMello.Presentation/Assets/Images/logo.png"
             Width="160" Height="160"
             HorizontalAlignment="Center"
             Margin="0,0,0,-15" />

      <!-- Logo: "Mark" + accent "Mello", bold, no italic -->
      <TextBlock FontFamily="{DynamicResource MmDocumentSerifFontFamily}"
                 FontSize="{DynamicResource MmUiFontSize44}"
                 FontWeight="Bold"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource MmTextBrush}">
        <Run Text="Mark" />
        <Run Text="Mello"
             Foreground="{DynamicResource MmAccentBrush}" />
      </TextBlock>

      <TextBlock Text="{Binding WelcomeTagline}"
                 FontFamily="{DynamicResource MmDocumentSansFontFamily}"
                 FontSize="{DynamicResource MmUiFontSize13}"
                 HorizontalAlignment="Center"
                 Foreground="{DynamicResource MmTextFaintBrush}"
                 Margin="0,0,0,28" />

      <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
        <Button Classes="welcome-secondary"
                Command="{Binding CreateNewDocumentCommand}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Path Data="M7 2.5V11.5M2.5 7H11.5"
                  Width="14"
                  Height="14"
                  Stroke="{DynamicResource MmTextSoftBrush}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round" />
            <TextBlock Text="{Binding WelcomeCreateMd}" />
          </StackPanel>
        </Button>
        <Button Classes="welcome-secondary"
                Command="{Binding OpenFolderCommand}">
          <StackPanel Orientation="Horizontal"
                      Spacing="8">
            <Path Data="M1.75 3.75A1 1 0 0 1 2.75 2.75H5.5L6.75 4.25H11.25A1 1 0 0 1 12.25 5.25V10.25A1 1 0 0 1 11.25 11.25H2.75A1 1 0 0 1 1.75 10.25Z"
                  Width="14"
                  Height="14"
                  Stroke="{DynamicResource MmTextSoftBrush}"
                  StrokeThickness="1.5"
                  StrokeLineCap="Round"
                  StrokeJoin="Round"
                  Fill="Transparent" />
            <TextBlock Text="{Binding WelcomeOpenFolder}" />
          </StackPanel>
        </Button>
        <Button Classes="welcome-primary"
                Content="{Binding WelcomeOpenFile}"
                Command="{Binding OpenFileCommand}" />
      </StackPanel>

      <!-- Hotkey hint -->
      <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center"
                  Margin="0,28,0,0">
        <Border Classes="kbd">
          <TextBlock Text="Ctrl" FontFamily="{DynamicResource MmDocumentMonoFontFamily}" FontSize="{DynamicResource MmUiFontSize10}" />
        </Border>
        <Border Classes="kbd">
          <TextBlock Text="O" FontFamily="{DynamicResource MmDocumentMonoFontFamily}" FontSize="{DynamicResource MmUiFontSize10}" />
        </Border>
        <TextBlock Text="{Binding WelcomeDropHint}"
                   FontSize="{DynamicResource MmUiFontSize11}"
                   Foreground="{DynamicResource MmTextFaintBrush}"
                   VerticalAlignment="Center" />
      </StackPanel>

    </StackPanel>
    <Button Classes="welcome-support"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Margin="0,0,0,40"
            Click="OnSupportClick">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path Data="M7 12.25C7 12.25 1.5 9.1 1.5 5.1C1.5 3.3 2.9 2 4.5 2C5.6 2 6.5 2.6 7 3.5C7.5 2.6 8.4 2 9.5 2C11.1 2 12.5 3.3 12.5 5.1C12.5 9.1 7 12.25 7 12.25Z"
              Width="14"
              Height="14"
              VerticalAlignment="Center" />
        <TextBlock Text="{Binding WelcomeSupport}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </Button>
  </controls:WelcomePanel>

</UserControl>
